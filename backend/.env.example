# Select: local (default), mock, api, spoonacular, or themealdb
AI_PROVIDER=local

# TheMealDB development/educational key. Public apps need an appropriate production key.
THEMEALDB_API_KEY=1

# Required only when AI_PROVIDER=spoonacular
SPOONACULAR_API_KEY=

# Required only when AI_PROVIDER=api (OpenAI-compatible endpoint)
AI_API_URL=
AI_API_KEY=
AI_MODEL=
FIREBASE_CREDENTIALS_JSON={"type":"service_account","project_id":"your-project-id"}
FIREBASE_PROJECT_ID=your-project-id
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
DATABASE_URL=sqlite:///./meal_muse.db
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
